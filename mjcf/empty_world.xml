<?xml version="1.0" encoding="utf-8"?>
<mujoco model="bcr_bot_empty_world">
  <include file="bcr_bot.xml"/>

  <asset>
    <texture name="ground_grid_texture" type="2d" builtin="checker"
             rgb1="0.35 0.35 0.35" rgb2="0.65 0.65 0.65"
             width="512" height="512"/>
    <material name="ground_grid" texture="ground_grid_texture"
              texrepeat="10 10" texuniform="true" reflectance="0.05"/>
  </asset>

  <statistic center="0 0 0.3" extent="1.5"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <worldbody>
    <light name="world_light" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="ground" type="plane" size="0 0 0.05" material="ground_grid"
          friction="1 0.005 0.0001"/>
  </worldbody>
</mujoco>
