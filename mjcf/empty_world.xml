<?xml version="1.0" encoding="utf-8"?>
<mujoco model="bcr_bot_empty_world">
  <include file="bcr_bot.xml"/>

  <asset>
    <texture name="ground_concrete" type="2d" file="mujoco_floor_texture.png"/>
    <material name="ground_floor" texture="ground_concrete" rgba="0.60 0.60 0.60 1"
              texrepeat="0.25 0.25" texuniform="true"
              specular="0" reflectance="0"/>
  </asset>

  <statistic center="0 0 0.3" extent="1.5"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <worldbody>
    <light name="world_light" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="ground" type="plane" size="0 0 0.05" material="ground_floor"
          friction="1 0.005 0.0001"/>
  </worldbody>
</mujoco>
